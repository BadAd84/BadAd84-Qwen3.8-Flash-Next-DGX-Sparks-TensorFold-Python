+#!/usr/bin/env python3
+"""tools/chain_stop_check.py: patch 0015 (where an MTP chain stops), CPU only, no model, in the image:
+
+    docker run --rm --entrypoint python3 -v "$PWD/tools:/t:ro" tensorfold-qwen38:v0.6.1 /t/chain_stop_check.py
+
+Checks `MultiDecoder`'s chain rules against reference implementations written here: the default rule is v0.6.1's
+(`conf`) and decides exactly as v0.6.1 does for every probability, depth and room; `_cal` is the `CAL` landing curve
+(its points, linear between them, flat past its ends); `cum` keeps the first draft and then drafts while the product
+of their calibrated chances stays at `TENSORFOLD_CHAIN_T` or above; `cost` / `adapt` / `acum` as documented;
+`_landed` feeds the probe and each stream's trust; `_draft_all`, driven with fake MTP steps, chains each stream as the
+rule says; the round reports drafted and landed rows to `_landed`. Prints PASS / FAIL lines and ALL PASS; exit 1 on any
+FAIL.
+"""
+from __future__ import annotations
+
+import ast
+import inspect
+import os
+import subprocess
+import sys
+import textwrap
+from types import SimpleNamespace as NS
+
+fails = 0
+
+
+def check(name, fn):
+    global fails
+    try:
+        ok, detail = fn()
+    except Exception as exc:                          # noqa: BLE001  (a broken rule is a FAIL, not a crash)
+        ok, detail = False, f"{type(exc).__name__}: {exc}"
+    print(("PASS " if ok else "FAIL ") + name + (f" ({detail})" if detail else ""), flush=True)
+    fails += not ok
+
+
+from tensorfold.families.qwen4_exp.cuda import multi as m  # noqa: E402
+
+M = m.MultiDecoder
+GRID = [i / 100 for i in range(0, 101)] + [0.1304, 0.9932, 0.5026, 1e-6, 0.999999]
+
+
+def settings():
+    env = {k: v for k, v in os.environ.items() if not k.startswith("TENSORFOLD_CHAIN")}
+    code = "from tensorfold.families.qwen4_exp.cuda import multi as m; print(m.CHAIN_RULE, m.CHAIN_T)"
+    plain = subprocess.run([sys.executable, "-c", code], env=env, capture_output=True, text=True).stdout.split()
+    env.update(TENSORFOLD_CHAIN_RULE="cum", TENSORFOLD_CHAIN_T="0.25")
+    set_ = subprocess.run([sys.executable, "-c", code], env=env, capture_output=True, text=True).stdout.split()
+    return plain == ["conf", "0.3"] and set_ == ["cum", "0.25"], f"default {plain}, with the settings {set_}"
+
+
+def decoder(rule="conf", t=0.30, confidence=0.6, tok_ms=None, depth=8):
+    d = object.__new__(M)
+    d.chain_rule, d.chain_t, d.confidence, d.tok_ms, d.depth, d.verdict = rule, t, confidence, tok_ms, depth, None
+    return d
+
+
+def cal_ref(p):
+    pts = m.CAL
+    if p <= pts[0][0]:
+        return pts[0][1]
+    for (p0, r0), (p1, r1) in zip(pts, pts[1:]):
+        if p <= p1:
+            return r0 + (r1 - r0) * (p - p0) / (p1 - p0)
+    return pts[-1][1]
+
+
+def conf_same():
+    bad = []
+    for conf in (0.0, 0.6, 0.7):
+        d = decoder("conf", confidence=conf)
+        for p in GRID:
+            for j in range(8):
+                for room in range(1, 9):
+                    low = conf > 0 and p < conf                  # v0.6.1's _draft_all, verbatim
+                    want = (not (low and j > 0), not low and j + 1 < room)
+                    s = NS(chain_q=1.0)
+                    if d._chain(s, j, p, room, 3, 4) != want:
+                        bad.append((conf, p, j, room))
+    return not bad, f"{len(GRID) * 8 * 8 * 3} decisions" + (f", differ at {bad[:3]}" if bad else "")
+
+
+def cal_curve():
+    knots = all(abs(M._cal(p) - r) < 1e-12 for p, r in m.CAL)
+    mids = all(abs(M._cal((p0 + p1) / 2) - (r0 + r1) / 2) < 1e-9 for (p0, r0), (p1, r1) in zip(m.CAL, m.CAL[1:]))
+    ends = M._cal(0.0) == m.CAL[0][1] and M._cal(1.0) == m.CAL[-1][1]
+    vals = [M._cal(p) for p in sorted(GRID)]
+    mono = all(a <= b + 1e-12 for a, b in zip(vals, vals[1:])) and all(0 <= v <= 1 for v in vals)
+    same = all(abs(M._cal(p) - cal_ref(p)) < 1e-12 for p in GRID)
+    return knots and mids and ends and mono and same, f"knots {knots}, midpoints {mids}, ends {ends}, monotone {mono}"
+
+
+def chain(d, ps, room, trust=None, chaining=1, live=1):
+    """Drive _chain as _draft_all does: the drafts kept, in order, until the rule ends the chain (the steps run to the
+    depth, len(ps); only the rule's answer keeps the chain within ``room``)."""
+    s = NS(chain_q=1.0)
+    if trust is not None:
+        s.trust = trust
+    kept = 0
+    for j, p in enumerate(ps):
+        keep, go = d._chain(s, j, p, room, chaining, live)
+        if not keep:
+            break
+        kept += 1
+        if not go:
+            break
+    return kept
+
+
+def cum_ref(ps, t, room, scale=1.0):
+    q, kept = 1.0, 0
+    for j, p in enumerate(ps[:room]):
+        q2 = q * min(1.0, cal_ref(p) * scale)
+        if not (j == 0 or q2 >= t):
+            break
+        q, kept = q2, kept + 1
+        if not (q2 >= t and j + 1 < room):
+            break
+    return kept
+
+
+def chains():
+    import random
+    rnd = random.Random(15)
+    return [[rnd.choice([rnd.random(), 0.9 + rnd.random() / 10, 0.99]) for _ in range(8)] for _ in range(400)] + \
+        [[0.99] * 8, [0.05] * 8, [0.99, 0.05, 0.99], [0.62] * 8]
+
+
+def cum_rule():
+    bad, total = [], 0
+    for t in (0.30, 0.15, 0.5):
+        d = decoder("cum", t=t)
+        for ps in chains():
+            for room in (1, 3, 8):
+                total += 1
+                if chain(d, ps, room) != cum_ref(ps, t, room):
+                    bad.append((t, room, ps[:3]))
+    first = all(chain(decoder("cum", t=0.99), [0.01] * 8, 8) == 1 for _ in range(1))
+    return not bad and first, f"{total} chains" + (f", differ at {bad[:2]}" if bad else "")
+
+
+def acum_rule():
+    bad, total = [], 0
+    for trust in (0.5, 1.0, 1.4):
+        d = decoder("acum", t=0.30)
+        for ps in chains():
+            total += 1
+            if chain(d, ps, 8, trust=trust) != cum_ref(ps, 0.30, 8, scale=trust):
+                bad.append((trust, ps[:3]))
+    return not bad, f"{total} chains, trust 0.5 / 1.0 / 1.4" + (f", differ at {bad[:2]}" if bad else "")
+
+
+def cost_rule():
+    bad, total = [], 0
+    for live in (1, 2, 4, 5):
+        for chaining in (1, 3):
+            for tok in (5.0, 12.0, 30.0):
+                d = decoder("cost", tok_ms=tok)
+                f = min(1.0, max(0.0, (live - 1) / 3))
+                row = m.ROW_MS[0] + (m.ROW_MS[1] - m.ROW_MS[0]) * f
+                for ps in chains()[:120]:
+                    q, want = 1.0, 0
+                    for j, p in enumerate(ps):
+                        c = min(1.0, cal_ref(p))
+                        q2 = q * c
+                        if not (j == 0 or q2 * tok >= row):
+                            break
+                        q, want = q2, want + 1
+                        if not (j + 1 < 8 and q2 * c * tok >= m.MTP_MS / chaining + row):
+                            break
+                    total += 1
+                    if chain(d, ps, 8, chaining=chaining, live=live) != want:
+                        bad.append((live, chaining, tok, ps[:3]))
+    untimed = decoder("cost", tok_ms=None)
+    fallback = all(untimed._chain(NS(chain_q=1.0), j, p, 8, 1, 1) == decoder("conf")._chain(NS(chain_q=1.0), j, p, 8, 1, 1)
+                   for p in GRID for j in range(4))
+    return not bad and fallback, f"{total} chains; untimed falls back to conf: {fallback}" + \
+        (f", differ at {bad[:2]}" if bad else "")
+
+
+def landed():
+    d = decoder("cum")
+    seen = []
+    d.verdict = lambda s, probs, n: seen.append((probs, n))
+    s = NS(draft_p=[0.9, 0.8, 0.4, 0.3], trust=1.0)
+    d._landed(s, 3, 1)                                # 3 drafted (the 4th never verified), 1 landed
+    want_ratio = min(1.5, max(0.5, 1 / (cal_ref(0.9) + cal_ref(0.8))))
+    ok1 = seen == [([0.9, 0.8, 0.4], 1)] and abs(s.trust - (0.8 + 0.2 * want_ratio)) < 1e-12
+    s2 = NS(draft_p=[0.99, 0.99], trust=1.0)
+    d._landed(s2, 2, 2)
+    ok2 = abs(s2.trust - (0.8 + 0.2 * min(1.5, 2 / (2 * cal_ref(0.99))))) < 1e-12
+    s3 = NS(draft_p=[], trust=0.7)
+    d._landed(s3, 0, 0)
+    ok3 = s3.trust == 0.7 and len(seen) == 2
+    return ok1 and ok2 and ok3, f"probe {seen[:1]}, trust {s.trust:.4f} / {s2.trust:.4f} / {s3.trust}"
+
+
+class State:
+    def __init__(self, pos):
+        self.pos, self.mtp_len, self.mtp_drafted = pos, pos, 0
+
+    def set_mtp_len(self, n):
+        self.mtp_len = n
+
