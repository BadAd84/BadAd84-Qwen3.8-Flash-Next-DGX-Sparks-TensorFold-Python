+def draft_all():
+    """_draft_all over four streams under `cum` 0.30: fake MTP steps whose logits name the stream, picks scripted per
+    stream and depth; each stream's drafts and recorded probabilities must follow the rule (stream 4 has room for 3
+    tokens only), and a second round must start each chain afresh."""
+    probs = {1: [0.99, 0.99, 0.99, 0.99, 0.99, 0.99, 0.99, 0.99], 2: [0.9, 0.62, 0.62, 0.62, 0.9, 0.9, 0.9, 0.9],
+             3: [0.3, 0.99, 0.99, 0.99, 0.99, 0.99, 0.99, 0.99], 4: [0.99] * 8}
+    count = {1: 100, 2: 100, 3: 100, 4: 4}
+    m.mtp_stage = lambda w, b, windows: [(st, i, i + len(keep)) for i, (st, keep, _) in enumerate(windows)]
+    d = decoder("cum", t=0.30, depth=8)
+    d.w, d.hints, d.chain_graphs = None, None, None
+    d.mbuf, d.buf = NS(streams=list(range(64))), NS(streams=list(range(64)))
+    d._mtp = lambda segs: [sid_of[id(st)] for st, _, _ in segs]
+    d._picks = lambda logits, positions, smp: [(100 * sid + (pos - st_of[sid].pos - 1), probs[sid][pos - st_of[sid].pos - 1])
+                                               for sid, pos in zip(logits, positions)]
+    streams = [NS(sid=i, st=State(40 + i), out=[7], count=count[i], copies=None, context=[], sampling=None,
+                  draft=True) for i in (1, 2, 3, 4)]
+    d.streams = {s.sid: s for s in streams}
+    sid_of = {id(s.st): s.sid for s in streams}
+    st_of = {s.sid: s.st for s in streams}
+    ok, got = True, []
+    for _ in range(2):
+        for s in streams:
+            s.st.mtp_drafted = 0
+        M._draft_all(d, [(s, 0, [7]) for s in streams])
+        for s in streams:
+            want = cum_ref(probs[s.sid], 0.30, min(8, s.count - len(s.out)))
+            ok &= s.drafts == [100 * s.sid + j for j in range(want)] and s.draft_p == probs[s.sid][:want]
+        got.append([len(s.drafts) for s in streams])
+    return ok and got[0] == got[1], f"drafts a stream {got}"
+
+
+def round_reports():
+    tree = ast.parse(textwrap.dedent(inspect.getsource(M.round)))
+    calls = [n for n in ast.walk(tree) if isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute)
+             and n.func.attr == "_landed"]
+    want = ["s", "len(tokens) - 1", "len(path) - 1"]
+    got = [[ast.unparse(a) for a in c.args] for c in calls]
+    return got == [want], f"round calls _landed{got}"
+
