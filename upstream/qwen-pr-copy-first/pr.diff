@@ -0,0 +1,239 @@
+#!/usr/bin/env python3
+"""tools/copy_first_check.py <config.json>: patch 0012 (copies from the context before MTP chains), CPU only, no
+weights, in the image. <config.json> is the checkpoint's (only its text config's sizes are read):
+
+    docker run --rm --entrypoint python3 -v "$PWD/tools:/t:ro" -v "$HOME/.cache/huggingface:/hf:ro" \
+      tensorfold-qwen38:v0.6.1 /t/copy_first_check.py \
+      /hf/hub/models--Vontra--Qwen3.8-Flash-Next-MLX-4bit-MTP/snapshots/<rev>/config.json
+
+Checks, against reference rules written here: a stream's copy window (`copies.Copies`: 16 rows first, doubling while
+copies land whole up to the most, halving after a break, a proposal at most the window less one row and the reply's
+room); `copies.fit` (every stream keeps its chain's rows, copies share the rest, oldest stream first);
+`MultiDecoder._draft_all` driven with fake MTP steps (a stream with a copy drafts it, the others chain from their own
+logits rows; the copy is asked for after the absorb, with the reply's room); the admission's window and scratch rows
+(`indexed_stream_geometry(rows=, scratch=)`); and the wiring, read from the code: copies on one GPU only, the decoder's
+rows, every slot's replay rows, a round's tokens taken before its drafts, the first token taken before a copy.
+The drafts change speed only; replies equal serial decoding (`"draft": false`), which this check does not run.
+Prints PASS / FAIL lines and ALL PASS; exit 1 on any FAIL.
+"""
+from __future__ import annotations
+
+import ast
+import inspect
+import json
+import sys
+import textwrap
+from types import SimpleNamespace as NS
+
+fails = 0
+
+
+def check(name, fn):
+    global fails
+    try:
+        ok, detail = fn()
+    except Exception as exc:                          # noqa: BLE001  (a missing or broken piece is a FAIL)
+        ok, detail = False, f"{type(exc).__name__}: {exc}"
+    print(("PASS " if ok else "FAIL ") + name + (f" ({detail})" if detail else ""), flush=True)
+    fails += not ok
+
+
+from tensorfold.families.qwen4_exp import cuda as pkg  # noqa: E402
+from tensorfold.families.qwen4_exp.cuda import multi as m  # noqa: E402
+from tensorfold.families.qwen4_exp.cuda import decode as dec, engine as eng  # noqa: E402
+from tensorfold.cuda import geometry as geo  # noqa: E402
+
+
+def window_rules():
+    from tensorfold.families.qwen4_exp.cuda.copies import Copies
+
+    text = list(range(100, 140))                      # 40 tokens, then other text, then its first 8 again
+    context = text + list(range(500, 520)) + text[:8]
+    c = Copies(7, 64)
+    first = c.rows
+    got = c.propose(context, 1000)
+    sizes = [len(got)]
+    trail = [c.rows]
+    for verified, kept in ((16, 16), (32, 32), (64, 64), (64, 10), (32, 3), (16, 2), (16, 16)):
+        c.copied = True
+        c.landed(verified, kept)
+        trail.append(c.rows)
+    c.rows = 64
+    sizes.append(len(c.propose(context, 1000)))       # 63 at most: the context holds 60 tokens after the match
+    sizes.append(len(c.propose(context, 10)))
+    sizes.append(len(c.propose(context, 7)))          # shorter than the 8 matched tokens: no copy
+    none = c.propose(list(range(60)), 1000)
+    copied_after_none = c.copied
+    c.rows = 32
+    c.landed(32, 32)                                  # not a copy this round: the window stays
+    want = [16, 32, 64, 64, 32, 16, 16, 32]
+    ok = (first == 16 and got == text[8:23] and trail == want and sizes == [15, 60, 10, 0] and none == []
+          and not copied_after_none and c.rows == 32)
+    return ok, f"first {first}, windows {trail}, proposals {sizes}"
+
+
+def fit_ref(live, rows, chain):
+    spare = rows - chain * len(live)
+    out = {}
+    for s in sorted(live, key=lambda x: x.sid):
+        take = min(max(0, len(s.drafts) + 1 - chain), spare)
+        out[s.sid] = chain - 1 + take
+        spare -= take
+    return out
+
+
+def fit_rule():
+    from tensorfold.families.qwen4_exp.cuda.copies import fit
+
+    import random
+    rnd = random.Random(12)
+    bad = 0
+    for _ in range(500):
+        n, chain = rnd.randint(1, 5), 7
+        rows = max(64, n * chain)
+        live = [NS(sid=sid, drafts=list(range(rnd.choice([0, 3, 6, 15, 40, 63])))) for sid in rnd.sample(range(50), n)]
+        want = {s.sid: min(len(s.drafts), k) for s, k in zip(live, [fit_ref(live, rows, chain)[s.sid] for s in live])}
+        before = {s.sid: list(s.drafts) for s in live}
+        fit(live, rows, chain)
+        used = sum(len(s.drafts) + 1 for s in live)
+        if any(len(s.drafts) != want[s.sid] or s.drafts != before[s.sid][:len(s.drafts)] for s in live) or used > rows:
+            bad += 1
+    old = [NS(sid=1, drafts=list(range(40))), NS(sid=2, drafts=list(range(40)))]
+    fit(old, 64, 7)
+    return not bad and [len(s.drafts) for s in old] == [40, 22], f"500 rounds, {bad} wrong; two copies of 40: " \
+        f"{[len(s.drafts) for s in old]} (the older stream first)"
+
+
+class Rows(list):
+    """The MTP step's logits rows (a tensor in the engine): ``logits[keep]`` keeps those rows."""
+
+    def __getitem__(self, i):
+        return Rows(list.__getitem__(self, k) for k in i) if isinstance(i, list) else list.__getitem__(self, i)
+
+
+class State:
+    def __init__(self, pos):
+        self.pos, self.mtp_len, self.mtp_drafted = pos, pos, 0
+
+    def set_mtp_len(self, n):
+        self.mtp_len = n
+
+
+def draft_all():
+    """Five streams, copies offered to streams 1, 3 and 4: those draft their copies, 2 and 5 chain from their own
+    logits rows; every copy is asked for after the absorb set its stream's MTP length, with the reply's room."""
+    calls = []
+    m.mtp_stage = lambda w, b, windows: [(st, i, i + len(keep)) for i, (st, keep, _) in enumerate(windows)]
+
+    def copies(sid, offer):
+        def propose(context, left):
+            s = by_sid[sid]
+            calls.append((sid, list(context), left, s.st.mtp_len))
+            return list(range(1000 * sid, 1000 * sid + min(offer, left))) if offer else []
+        return NS(propose=propose)
+
+    d = object.__new__(m.MultiDecoder)
+    d.depth, d.confidence, d.w, d.hints, d.chain_graphs = 6, 0.6, None, None, None
+    d.chain_rule, d.chain_t, d.tok_ms, d.verdict = "conf", 0.3, None, None
+    d.mbuf, d.buf = NS(streams=list(range(64))), NS(streams=list(range(64)))
+    d._mtp = lambda segs: Rows(sid_of[id(st)] for st, _, _ in segs)
+    d._picks = lambda logits, positions, smp: [(10 * sid + 1, 0.99) for sid in logits]
+    offers = {1: 20, 2: 0, 3: 40, 4: 3, 5: 0}
+    streams = [NS(sid=i, st=State(30), out=[9] * i, count=40, context=[i, 9], sampling=None, draft=True,
+                  copies=copies(i, offers[i])) for i in offers]
+    by_sid = {s.sid: s for s in streams}
+    d.streams = dict(by_sid)
+    sid_of = {id(s.st): s.sid for s in streams}
+    keeps = {1: [9], 2: [9, 9], 3: [9], 4: [9, 9, 9], 5: [9]}
+    m.MultiDecoder._draft_all(d, [(s, 0, keeps[s.sid]) for s in streams])
+    ok = True
+    for s in streams:
+        room = s.count - len(s.out)
+        want = list(range(1000 * s.sid, 1000 * s.sid + min(offers[s.sid], room))) if offers[s.sid] else \
+            [10 * s.sid + 1] * 6
+        ok &= s.drafts == want
+    asked = [(sid, left, mtp) for sid, _, left, mtp in calls]
+    ok &= asked == [(s.sid, s.count - len(s.out), 30 + len(keeps[s.sid])) for s in streams]
+    every = []
+    for offer_all in (True, False):
+        for s in streams:
+            s.copies = copies(s.sid, 5 if offer_all else 0)
+            s.st = State(30)
+        sid_of = {id(s.st): s.sid for s in streams}
+        m.MultiDecoder._draft_all(d, [(s, 0, [9]) for s in streams])
+        every.append([len(s.drafts) for s in streams])
+    ok &= every == [[5] * 5, [6] * 5]
+    return ok, f"drafts {[s.drafts[:2] for s in streams]}, copies asked (stream, room, MTP length) {asked}, " \
+        f"all / none copying {every}"
+
+
+def geometry(config):
+    t = json.load(open(config))
+    t = t.get("text_config", t)
+    streams, each, keep = 5, 7, 8
+    base = geo.indexed_stream_geometry(t, streams, each, keep, mtp=True, kv_bits=8)
+    same = geo.indexed_stream_geometry(t, streams, each, keep, mtp=True, kv_bits=8, rows=streams * each, scratch=each)
+    wide = geo.indexed_stream_geometry(t, streams, each, keep, mtp=True, kv_bits=8, rows=64, scratch=64)
+    linear, _ = geo.layer_counts(t)
+    _, _, _, _, nk, nv, dk, dv, _ = geo._gdn_dims(t, 1)
+    per_row = streams * linear * (nk * dk * 4 + nv * dv * 4 + nv * 8)
+    scr = geo.indexed_stream_geometry(t, streams, each, keep, mtp=True, kv_bits=8, scratch=64)
+    caps = (4096, 65536, 262144)
+    ok = all(same.bytes_at(c) == base.bytes_at(c) for c in caps) and \
+        all(scr.bytes_at(c) - base.bytes_at(c) == (64 - each) * per_row for c in caps) and \
+        all(wide.bytes_at(c) > scr.bytes_at(c) for c in caps)
+    return ok, f"at 262,144: {base.bytes_at(262144) / 2**30:.3f} GiB -> {wide.bytes_at(262144) / 2**30:.3f} GiB " \
+        f"(64 replay rows a slot, 64 window rows)"
+
+
+def _assign(fn, target):
+    tree = ast.parse(textwrap.dedent(inspect.getsource(fn)))
+    for n in ast.walk(tree):
+        if isinstance(n, ast.Assign) and any(ast.unparse(t) == target for t in n.targets):
+            return compile(ast.Expression(n.value), target, "eval")
+    raise LookupError(f"no assignment to {target} in {fn.__qualname__}")
+
+
+def _lines(fn, text):
+    src = textwrap.dedent(inspect.getsource(fn)).splitlines()
+    return [i for i, line in enumerate(src) if text in line]
+
+
+def wiring():
+    init = m.MultiDecoder.__init__
+    cr = _assign(init, "self.copy_rows")
+    copy_rows = [eval(cr, {"copy_rows": 64, "depth": dp, "w": NS(comm=c)}) for dp, c in ((6, None), (0, None), (6, 1))]
+    rows = eval(_assign(init, "rows"), {"max": max, "slots": 10, "depth": 6, "self": NS(copy_rows=64)})
+    rows1 = eval(_assign(init, "rows"), {"max": max, "slots": 1, "depth": 6, "self": NS(copy_rows=64)})
+    slot = "max(depth + 1, self.copy_rows)" in inspect.getsource(init)
+    load = None
+    for _, cls in inspect.getmembers(eng, inspect.isclass):
+        for _, f in inspect.getmembers(cls, inspect.isfunction) if cls.__module__ == eng.__name__ else ():
+            try:
+                _assign(f, "copies")
+                load = f
+            except (LookupError, OSError, TypeError):
+                pass
+    on = [eval(_assign(load, "copies"), {"mtp": mtp, "tp": tp}) for mtp, tp in ((True, 1), (True, 2), (False, 1))]
+    serial = "prompt" in inspect.signature(dec.mtp_decode).parameters and \
+        "prompt=prompt if self.tp == 1 else ()" in inspect.getsource(eng)
+    rnd = m.MultiDecoder.round
+    take, draft, landed = _lines(rnd, "s.take(new"), _lines(rnd, "self._draft_all("), \
+        _lines(rnd, "s.copies.landed(len(tokens), len(path))")
+    join = m.MultiDecoder._joined
+    first, copy = _lines(join, "s.take([first]"), _lines(join, "s.copies.propose(s.context")
+    ok = (copy_rows == [64, 0, 0] and rows == 70 and rows1 == 64 and slot and on == [True, False, False] and serial
+          and pkg.COPY_ROWS == 64 and take and draft and take[-1] < draft[0] and len(landed) == 1
+          and first and copy and first[0] < copy[0])
+    return ok, f"copy rows (one GPU / no MTP / two ranks) {copy_rows}, decoder rows at 10 / 1 streams {rows} / {rows1}, " \
+        f"copies on (one GPU, two ranks, no MTP) {on}, serial decode copies {serial}, take before drafts " \
+        f"{take[-1:]} < {draft[:1]}, first token before a copy {first[:1]} < {copy[:1]}"
+
+
+check("a copy's window: 16 rows, doubling while copies land whole (to 64), halving after a break", window_rules)
+check("copies.fit: chains keep their rows, copies share the rest, oldest stream first", fit_rule)
+check("_draft_all: copies drafted, the other streams chain from their own logits rows", draft_all)
+check("admission counts the 64-row window and every slot's 64 replay rows", lambda: geometry(sys.argv[1]))
+check("wiring: one GPU only, the decoder's rows, slots' replay rows, take before drafts, first token first", wiring)
+print("ALL PASS" if not fails else f"{fails} FAIL", flush=True)
+sys.exit(1 if fails else 0)
