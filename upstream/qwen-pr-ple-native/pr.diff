@@ -0,0 +1,190 @@
+#!/usr/bin/env python3
+"""tools/ple_native_check.py [scratch dir]: patch 0014 (--ple-on-ssd n-gram reads in native threads), CPU only, no
+model, in the image (it builds the reader with the image's compiler, about a minute the first time). The scratch dir
+must be on a real disk (ext4, xfs), not tmpfs or the container's overlay: the check writes a small n-gram table there
+(three safetensors files, ~25 MB) and drops its pages to read it cold.
+
+    mkdir -p /tmp/plecheck && docker run --rm --entrypoint python3 -v "$PWD/tools:/t:ro" -v /tmp/plecheck:/d \
+      tensorfold-qwen38:v0.6.1 /t/ple_native_check.py /d
+
+Checks: the native reader builds and every gather uses it (`TENSORFOLD_PLE_NATIVE=0` turns it off); its read table
+is the Python path's reads (the same file, offset, length and place for each run of adjacent rows, runs split at
+MAX_READ); every gather returns exactly the memory-mapped `HostTable`'s rows and the Python reads' (dtype, shape,
+bytes) for decode-sized, prompt-sized, long-run, shard-boundary and repeated id sets, cold and warm; a table file cut
+short raises instead of returning rows. Prints PASS / FAIL lines and ALL PASS; exit 1 on any FAIL.
+"""
+from __future__ import annotations
+
+import json
+import os
+import struct
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+import numpy as np
+
+fails = 0
+
+
+def check(name, fn):
+    global fails
+    try:
+        ok, detail = fn()
+    except Exception as exc:                          # noqa: BLE001  (a missing or broken piece is a FAIL)
+        ok, detail = False, f"{type(exc).__name__}: {exc}"
+    print(("PASS " if ok else "FAIL ") + name + (f" ({detail})" if detail else ""), flush=True)
+    fails += not ok
+
+
+from tensorfold.families.qwen4_exp import host_table, ssd_table  # noqa: E402
+
+NAME, G = "model.layers.0.ngram_embedding", 16    # scales a row (bf16): rows of 4 x 16 words, 32 B scales and biases
+
+
+def write_table(d: Path) -> int:
+    """Three safetensors files holding six shards of random rows (the parts in differing orders), like the
+    checkpoint's MLX 4-bit n-gram table. Returns the shard count."""
+    rng = np.random.default_rng(13)
+    shards = [(0, 2000), (0, 5300), (1, 4100), (1, 700), (2, 6000), (2, 3900)]
+    for f in range(3):
+        header, blobs, at = {}, [], 0
+        for i, (fi, rows) in enumerate(shards):
+            if fi != f:
+                continue
+            parts = [("weight", "U32", 4 * G, 4), ("scales", "BF16", G, 2), ("biases", "BF16", G, 2)]
+            for part, dtype, cols, item in (parts if i % 2 else parts[::-1]):
+                data = rng.integers(0, 256, rows * cols * item, dtype=np.uint8).tobytes()
+                header[f"{NAME}.shard_{i}.{part}"] = {"dtype": dtype, "shape": [rows, cols],
+                                                      "data_offsets": [at, at + len(data)]}
+                blobs.append(data)
+                at += len(data)
+        head = json.dumps(header).encode()
+        (d / f"model-{f:05d}-of-00003.safetensors").write_bytes(struct.pack("<Q", len(head)) + head + b"".join(blobs))
+    return len(shards)
+
+
+def tables(d: Path):
+    return (host_table.from_checkpoint(d, NAME, COUNT, ssd=True), host_table.from_checkpoint(d, NAME, COUNT))
+
+
+def evict(t) -> None:
+    for fd in t._fds:
+        os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
+
+
+def cases(rows, starts):
+    rng = np.random.default_rng(1234)
+    bounds = np.concatenate([starts[1:-1] - 1, starts[1:-1], [0, rows - 1]])
+    return [("decode, 1 stream", rng.integers(0, rows, 112)),
+            ("decode, 4 streams with repeats", np.concatenate([rng.integers(0, rows, 400),
+                                                               rng.integers(0, rows, 30).repeat(3)])),
+            ("prompt chunk", rng.integers(0, rows, 16384)),
+            ("one id", np.array([rows // 3])),
+            ("long runs past MAX_READ", np.concatenate([np.arange(2000, 7300), np.arange(11500, rows)])),
+            ("adjacent runs", np.concatenate([np.arange(s, s + n) for s, n in zip(rng.integers(0, rows - 6000, 5),
+                                                                                (1, 2, 50, 700, 5000))])),
+            ("shard boundaries", np.concatenate([bounds, bounds[::-1]])),
+            ("unsorted repeats", rng.permutation(np.repeat(rng.integers(0, rows, 3000), 4)))]
+
+
+def same(a, b):
+    return all(x.dtype == y.dtype and x.shape == y.shape and np.array_equal(x, y) for x, y in zip(a, b))
+
+
+def engaged():
+    code = "from tensorfold.families.qwen4_exp import ssd_table as s; print(s.NATIVE)"
+    env = {k: v for k, v in os.environ.items() if k != "TENSORFOLD_PLE_NATIVE"}
+    on = subprocess.run([sys.executable, "-c", code], env=env, capture_output=True, text=True).stdout.strip()
+    off = subprocess.run([sys.executable, "-c", code], env={**env, "TENSORFOLD_PLE_NATIVE": "0"},
+                         capture_output=True, text=True).stdout.strip()
+    built = ssd_table._native() is not None
+    ssd, _ = tables(DIR)
+    used = [0]
+    native = type(ssd)._gather_native
+
+    def counting(self, *a):
+        used[0] += 1
+        return native(self, *a)
+
+    sets = cases(ssd.rows, ssd.starts)
+    type(ssd)._gather_native = counting
+    try:
+        for _, ids in sets:
+            ssd.gather(ids)
+    finally:
+        type(ssd)._gather_native = native
+        ssd.close()
+    n = len(sets)
+    return on == "True" and off == "False" and built and used[0] == n, \
+        f"default {on}, TENSORFOLD_PLE_NATIVE=0 {off}, built {built}, {used[0]} of {n} gathers native"
+
+
+def same_reads():
+    ssd, _ = tables(DIR)
+    rng = np.random.default_rng(5)
+    bad = 0
+    for ids in [np.unique(rng.integers(0, ssd.rows, n)) for n in (1, 7, 300, 5000)] + [np.arange(0, ssd.rows)]:
+        shard = np.searchsorted(ssd.starts, ids, side="right") - 1
+        local, where = ids - ssd.starts[shard], ssd.fidx[shard]
+        for part, width in enumerate((ssd.wrow, ssd.grow, ssd.grow)):
+            offsets = ssd.bases[shard, part] + local * width
+            out = np.empty((ids.size, width), dtype=np.uint8)
+            py = [(fd, off, size, at) for fd, off, size, _, at in ssd._reads(where, offsets, width, out)]
+            nat = [tuple(int(v) for v in r) for r in ssd._runs(where, offsets, width, 0)]
+            bad += py != nat
+    ssd.close()
+    return not bad, f"{bad} read tables differ"
+
+
+def rows_match():
+    ssd, host = tables(DIR)
+    bad, n = [], 0
+    for cold in (True, False):
+        for name, ids in cases(ssd.rows, ssd.starts):
+            if cold:
+                evict(ssd)
+            got = ssd.gather(ids)
+            ssd_table.NATIVE = False
+            if cold:
+                evict(ssd)
+            py = ssd.gather(ids)
+            ssd_table.NATIVE = True
+            n += 1
+            if not (same(got, host.gather(ids)) and same(got, py)):
+                bad.append(f"{'cold' if cold else 'warm'} {name}")
+    ssd.close()
+    return not bad, f"{n} gathers, native = memory map = Python reads" + (f", DIFFER: {bad}" if bad else "")
+
+
+def short_file():
+    import shutil
+    cut = DIR / "cut"
+    cut.mkdir()
+    for f in DIR.glob("*.safetensors"):
+        shutil.copy(f, cut / f.name)
+    ssd = host_table.from_checkpoint(cut, NAME, COUNT, ssd=True)
+    last = cut / "model-00002-of-00003.safetensors"
+    os.truncate(last, last.stat().st_size - 50_000)
+    try:
+        ssd.gather(np.array([ssd.rows - 1]))
+        raised = "nothing"
+    except (RuntimeError, OSError) as exc:
+        raised = type(exc).__name__
+    ssd.close()
+    shutil.rmtree(cut)
+    return raised != "nothing", f"a read past the cut raised {raised}"
+
+
+DIR = Path(tempfile.mkdtemp(prefix="plecheck-", dir=sys.argv[1] if len(sys.argv) > 1 else None))
+COUNT = write_table(DIR)
+check("the native reader builds and every gather uses it; TENSORFOLD_PLE_NATIVE=0 turns it off", engaged)
+check("its reads are the Python path's: file, offset, length and place for each run", same_reads)
+check("gathers return the memory-mapped table's rows and the Python reads', cold and warm", rows_match)
+check("a table file cut short raises instead of returning rows", short_file)
+for f in DIR.iterdir():
+    f.unlink()
+DIR.rmdir()
+print("ALL PASS" if not fails else f"{fails} FAIL", flush=True)
+sys.exit(1 if fails else 0)
