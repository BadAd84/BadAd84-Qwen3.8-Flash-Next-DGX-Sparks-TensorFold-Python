+Flash Next with --ple-on-ssd: n-gram reads in native threads with Python's GIL released (a load_inline C++ reader: the same files, offsets and bytes). TENSORFOLD_PLE_NATIVE=0 restores the Python reads.
+--- tensorfold/families/qwen4_exp/ssd_table.py
++++ tensorfold/families/qwen4_exp/ssd_table.py
+@@ -2,6 +2,7 @@
+ 
+ from __future__ import annotations
+ 
++import functools
+ import os
+ import struct
+ import sys
+@@ -14,6 +15,90 @@
+ WORKERS = 16                # reads in flight at once: os.pread releases the GIL
+ MAX_READ = 1 << 20          # bytes one read of adjacent rows may cover
+ NOWAIT_READS = 4096         # a gather of at most this many reads (a decode window's) does the cached ones itself first
++# The reads in native threads (TENSORFOLD_PLE_NATIVE=0: Python's, as above): a prompt chunk's ~50k row reads went
++# through 16 Python threads at ~9 us of GIL each; a decode window's cached reads cost ~2 us each on the engine thread.
++NATIVE = os.environ.get("TENSORFOLD_PLE_NATIVE", "1") != "0"
++NATIVE_PER = 512            # reads a native thread takes at least: a decode window reads on one thread (measured,
++                            # warm: 336 reads 0.09 ms on 1 thread, 0.12 on 4; 1,470 reads 0.39 / 0.34 ms)
++NATIVE_THREADS = 64         # threads at most: a cold prompt chunk waits on the disk, more reads in flight
++_SOURCE = r"""
++#include <torch/extension.h>
++#include <atomic>
++#include <cerrno>
++#include <stdexcept>
++#include <system_error>
++#include <thread>
++#include <vector>
++#include <unistd.h>
++
++// reads [n, 4] int64 (fd, file offset, bytes, offset in out), every one read into out by `threads` threads with the
++// GIL released, finishing short reads; end of file means the checkpoint changed.
++void gather_reads(torch::Tensor reads, torch::Tensor out, int64_t threads) {
++  TORCH_CHECK(reads.scalar_type() == torch::kInt64 && reads.dim() == 2 && reads.size(1) == 4 && reads.is_contiguous());
++  TORCH_CHECK(out.scalar_type() == torch::kUInt8 && out.is_contiguous() && out.device().is_cpu());
++  const int64_t* r = reads.data_ptr<int64_t>();
++  uint8_t* o = out.data_ptr<uint8_t>();
++  const int64_t n = reads.size(0), cap = out.numel();
++  for (int64_t i = 0; i < n; ++i)
++    TORCH_CHECK(r[4 * i + 2] >= 0 && r[4 * i + 3] >= 0 && r[4 * i + 3] + r[4 * i + 2] <= cap, "read past the buffer");
++  std::atomic<int64_t> next{0};
++  std::atomic<int> err{0};
++  {
++    pybind11::gil_scoped_release nogil;
++    auto work = [&]() {
++      for (;;) {
++        const int64_t i = next.fetch_add(1);
++        if (i >= n || err.load() != 0) return;
++        const int fd = static_cast<int>(r[4 * i]);
++        const int64_t off = r[4 * i + 1], size = r[4 * i + 2], at = r[4 * i + 3];
++        int64_t done = 0;
++        while (done < size) {
++          const ssize_t got = pread(fd, o + at + done, size - done, off + done);
++          if (got < 0) {
++            if (errno == EINTR) continue;
++            err.store(errno);
++            return;
++          }
++          if (got == 0) {
++            err.store(-1);
++            return;
++          }
++          done += got;
++        }
++      }
++    };
++    const int64_t t = std::max<int64_t>(1, std::min<int64_t>(threads, n));
++    std::vector<std::thread> pool;
++    for (int64_t k = 1; k < t; ++k) pool.emplace_back(work);
++    work();
++    for (auto& th : pool) th.join();
++  }
++  const int e = err.load();
++  if (e == -1) throw std::runtime_error("short read of the n-gram tables: the checkpoint changed");
++  if (e != 0) throw std::system_error(e, std::generic_category(), "n-gram table read");
++}
++"""
++
++
++@functools.lru_cache(maxsize=1)
++def _native():
++    """The native reader (built once into TORCH_EXTENSIONS_DIR), or None where it can't build: the Python reads."""
++
++    try:
++        from torch.utils.cpp_extension import load_inline
++
++        return load_inline(name="tensorfold_ple_gather", cpp_sources=[_SOURCE], functions=["gather_reads"],
++                           extra_cflags=["-O2"], verbose=False)
++    except Exception as exc:                     # noqa: BLE001  (no compiler: the Python path, as before)
++        print(f"[tensorfold] n-gram reads: native reader unavailable ({type(exc).__name__}: {exc}); Python reads",
++              file=sys.stderr, flush=True)
++        return None
++
++
++def torch_from(a: np.ndarray):
++    import torch
++
++    return torch.from_numpy(a)
+ _KINDS = (("weight", "U32", 4), ("scales", "BF16", 2), ("biases", "BF16", 2))
+ # RWF_NOWAIT: a read that would wait on the disk fails at once (TENSORFOLD_PLE_NOWAIT=0: every read to the threads)
+ _NOWAIT = getattr(os, "RWF_NOWAIT", None) \
+@@ -98,6 +183,8 @@
+         except BaseException:
+             self.close()
+             raise
++        if NATIVE:
++            _native()                                # built (or found) at load, not at a request's first lookup
+ 
+     def _layout(self, files: list[tuple[Path, dict, dict, dict]], nocache: bool) -> None:
+         if not files:
+@@ -150,6 +237,9 @@
+         unique, inverse = np.unique(flat.astype(np.int64), return_inverse=True)
+         shard = np.searchsorted(self.starts, unique, side="right") - 1
+         local, where = unique - self.starts[shard], self.fidx[shard]
++        native = _native() if NATIVE else None
++        if native is not None and unique.size:
++            return self._gather_native(native, unique.size, inverse, shard, local, where)
+         outs, reads = [], []
+         for part, width in enumerate((self.wrow, self.grow, self.grow)):
+             outs.append(np.empty((unique.size, width), dtype=np.uint8))
+@@ -164,6 +254,35 @@
+         words, scales, biases = (out[inverse] for out in outs)
+         return words.view(np.uint32), scales.view(np.uint16), biases.view(np.uint16)
+ 
++    def _gather_native(self, native, n: int, inverse, shard, local, where):
++        """``gather``'s rows read by the native extension: the same reads (one a run of adjacent rows), every one in
++        native threads without Python's GIL, into one buffer holding the words, scales and biases parts."""
++
++        widths = (self.wrow, self.grow, self.grow)
++        buf = np.empty(n * sum(widths), dtype=np.uint8)
++        parts, table, base = [], [], 0
++        for part, width in enumerate(widths):
++            parts.append(buf[base:base + n * width].reshape(n, width))
++            table.append(self._runs(where, self.bases[shard, part] + local * width, width, base))
++            base += n * width
++        reads = np.concatenate(table)
++        threads = min(NATIVE_THREADS, max(1, reads.shape[0] // NATIVE_PER))
++        native.gather_reads(torch_from(reads), torch_from(buf), threads)
++        words, scales, biases = (out[inverse] for out in parts)
++        return words.view(np.uint32), scales.view(np.uint16), biases.view(np.uint16)
++
++    def _runs(self, where: np.ndarray, offsets: np.ndarray, width: int, at: int) -> np.ndarray:
++        """``_reads``'s reads as rows (fd, file offset, bytes, offset in the buffer) of an int64 array."""
++
++        n = offsets.size
++        cut = np.ones(n, dtype=bool)
++        cut[1:] = (where[1:] != where[:-1]) | (offsets[1:] != offsets[:-1] + width)
++        first = np.flatnonzero(cut)
++        cut |= (np.arange(n) - first[np.cumsum(cut) - 1]) % max(1, MAX_READ // width) == 0
++        first = np.flatnonzero(cut)
++        rows = np.diff(first, append=n)
++        return np.stack([self._fd_of[where[first]], offsets[first], rows * width, at + first * width], axis=1)
++
+     def _reads(self, where: np.ndarray, offsets: np.ndarray, width: int, out: np.ndarray) -> list[tuple]:
+         """One read per run of rows adjacent in one file, each at most MAX_READ bytes, into ``out``'s rows."""
+ 
