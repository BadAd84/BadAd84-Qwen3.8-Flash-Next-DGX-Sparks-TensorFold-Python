@@ -0,0 +1,172 @@
+#!/usr/bin/env python3
+"""tools/ple_defer_check.py: patch 0017 (a decode round's n-gram rows staged when the forward reaches the n-gram
+layer), CPU only, no model, in the image:
+
+    docker run --rm --entrypoint python3 -v "$PWD/tools:/t:ro" tensorfold-qwen38:v0.6.1 /t/ple_defer_check.py
+
+Runs the patch's own `forward.stage` and `forward.ple_block` on CPU buffers with a fake n-gram table, the GPU kernels
+stood in for by recorders that copy the staged buffers at each launch. Checks: with `defer_ple` the n-gram rows are
+not staged by `stage` but by `ple_block`, before its first kernel, and the stream's event is recorded after their
+copies; the kernels then see exactly the bytes an immediate staging puts there (and each stream's `ple_last` is the
+same); without `defer_ple`, or with no n-gram layer, `stage` stages them as v0.6.1 does; the decode round defers only
+when no prompt pass shares its forward, and clears a deferred staging when its forward ends; `TENSORFOLD_PLE_DEFER=0`
+turns it off. Prints PASS / FAIL lines and ALL PASS; exit 1 on any FAIL.
+"""
+from __future__ import annotations
+
+import ast
+import inspect
+import os
+import subprocess
+import sys
+import textwrap
+from types import SimpleNamespace as NS
+
+import numpy as np
+import torch
+
+fails = 0
+
+
+def check(name, fn):
+    global fails
+    try:
+        ok, detail = fn()
+    except Exception as exc:                          # noqa: BLE001  (a missing or broken piece is a FAIL)
+        ok, detail = False, f"{type(exc).__name__}: {exc}"
+    print(("PASS " if ok else "FAIL ") + name + (f" ({detail})" if detail else ""), flush=True)
+    fails += not ok
+
+
+from tensorfold.families.qwen4_exp.cuda import forward as fw  # noqa: E402
+
+HEADS, W, G = 4, 8, 2                                 # n-gram heads, words and scales a row (a small table)
+LOG: list = []                                        # (event) in launch order
+
+
+class Recorder:
+    """The glue kernels and matmuls: each launch logs its name and the staged words it would read."""
+
+    def __init__(self, b):
+        self.b = b
+
+    def __getattr__(self, name):
+        def launch(*a, **k):
+            LOG.append((name, self.b.ple_w.clone(), self.b.ple_s.clone(), self.b.ple_b.clone()))
+        return launch
+
+
+class Event:
+    def synchronize(self):
+        LOG.append(("synchronize",))
+
+    def record(self):
+        LOG.append(("record",))
+
+
+class Table:
+    def gather(self, ids):
+        ids = np.asarray(ids, dtype=np.int64).reshape(-1)
+        words = (ids[:, None] * 31 + np.arange(W)).astype(np.uint32)
+        scales = (ids[:, None] * 7 + np.arange(G)).astype(np.uint16)
+        return words, scales, (scales + 3).astype(np.uint16)
+
+
+def ngram_ids(history, toks):
+    return (np.asarray(toks, dtype=np.int64)[:, None] * 10 + np.arange(HEADS) + int(history[0])) % 1000
+
+
+def setup(ple=True):
+    rows = 16
+    b = NS(rows=rows, staged=Event(), ids_host=torch.zeros(rows, dtype=torch.int32), ids=torch.zeros(rows, dtype=torch.int32),
+           ple_hw=torch.zeros(rows * HEADS, W, dtype=torch.int32), ple_hs=torch.zeros(rows * HEADS, G, dtype=torch.int16),
+           ple_hb=torch.zeros(rows * HEADS, G, dtype=torch.int16),
+           ple_w=torch.full((rows * HEADS, W), -1, dtype=torch.int32),
+           ple_s=torch.zeros(rows * HEADS, G, dtype=torch.bfloat16), ple_b=torch.zeros(rows * HEADS, G, dtype=torch.bfloat16))
+    for name in ("ple_emb", "xs_ple", "ple_keys", "ple_vals", "h", "ple_gated", "ple_pss", "ple_nrow"):
+        setattr(b, name, torch.zeros(rows, 2))
+    p = NS(table=Table(), ngram=NS(ids=ngram_ids, heads=HEADS, dims=W), key=None, value=None, norm_key=None,
+           norm_query=None, norm_conv=None, conv=None)
+    layers = [NS(ple=None), NS(ple=None), NS(ple=p if ple else None), NS(ple=None)]
+    w = NS(x3=None, layers=layers, cfg=NS(eps=1e-6, streams=4, ngram_size=3))
+    sts = [NS(pos=10 * i, capacity=4096, ple_history=np.array([i * 100]), ple_tail=None) for i in (1, 2, 3)]
+    windows = [(sts[0], [5, 6, 7]), (sts[1], [8]), (sts[2], [9, 10, 11, 12])]
+    fw.glue = Recorder(b)
+    fw._mm = Recorder(b).mm
+    return w, b, windows, p, layers
+
+
+def immediate():
+    w, b, windows, _, _ = setup()
+    LOG.clear()
+    segs = fw.stage(w, b, windows)
+    staged = (b.ple_w.clone(), b.ple_s.clone(), b.ple_b.clone())
+    rec_after = [e[0] for e in LOG] == ["synchronize", "record"]
+    lasts = [st.ple_last[1].tolist() for st, _ in windows]
+    return staged, segs, rec_after and getattr(b, "ple_staging", None) is None, lasts
+
+
+def deferred():
+    REF, _, plain_ok, ref_lasts = immediate()
+    w, b, windows, p, layers = setup()
+    LOG.clear()
+    segs = fw.stage(w, b, windows, defer_ple=True)
+    untouched = bool((b.ple_w == -1).all()) and getattr(b, "ple_staging", None) is not None
+    LOG.clear()
+    R = segs[-1][2]
+    fw.ple_block(layers[2], w, segs, b, R)
+    kernels = [e for e in LOG if len(e) == 4]
+    first = kernels[0] if kernels else None
+    seen = first is not None and all(torch.equal(x, y) for x, y in zip(first[1:], REF))
+    names = [e[0] for e in LOG]
+    order = "record" in names and kernels and names.index("record") < names.index(kernels[0][0])
+    cleared = getattr(b, "ple_staging", None) is None
+    lasts = [st.ple_last[1].tolist() for st, _ in windows]
+    ok = plain_ok and untouched and seen and order and cleared and lasts == ref_lasts and int(REF[0][0, 0]) != -1
+    return ok, f"stage left the buffers alone {untouched}; the first kernel ({first[0] if first else None}) saw the " \
+        f"immediate staging's bytes {seen}; event recorded before it {bool(order)}; cleared {cleared}; v0.6.1 path " \
+        f"stages in stage {plain_ok}"
+
+
+def no_ple():
+    w, b, windows, _, _ = setup(ple=False)
+    segs = fw.stage(w, b, windows, defer_ple=True)
+    return getattr(b, "ple_staging", None) is None and segs[-1][2] == 8, "no n-gram layer: nothing deferred"
+
+
+def round_wiring():
+    from tensorfold.families.qwen4_exp.cuda import multi as m
+
+    tree = ast.parse(textwrap.dedent(inspect.getsource(m.MultiDecoder.round)))
+    call = next(n for n in ast.walk(tree) if isinstance(n, ast.Call) and ast.unparse(n.func) == "stage"
+                and ast.unparse(n.args[1]) == "self.buf")
+    kw = next(k.value for k in call.keywords if k.arg == "defer_ple")
+    expr = compile(ast.Expression(kw), "defer_ple", "eval")
+    table = {(d, f, c): eval(expr, {"PLE_DEFER": d, "self": NS(filling=f, converged=c)})
+             for d in (True, False) for f in ((), (1,)) for c in (True, False)}
+    want = {(d, f, c): d and not (f and c) for d, f, c in table}
+    want = {k: bool(v) for k, v in want.items()}
+    finals = [n for n in ast.walk(tree) if isinstance(n, ast.Try) and n.finalbody]
+    cleared = any("self.buf.ple_staging" in ast.unparse(s) and "None" in ast.unparse(s) for t in finals
+                  for s in t.finalbody)
+    got = {k: bool(v) for k, v in table.items()}
+    return got == want and cleared, f"defers alone, never beside a shared prompt pass: {got == want}; cleared in " \
+        f"the forward's finally: {cleared}"
+
+
+def switch():
+    code = "from tensorfold.families.qwen4_exp.cuda import multi as m; print(m.PLE_DEFER)"
+    env = {k: v for k, v in os.environ.items() if k != "TENSORFOLD_PLE_DEFER"}
+    on = subprocess.run([sys.executable, "-c", code], env=env, capture_output=True, text=True).stdout.strip()
+    off = subprocess.run([sys.executable, "-c", code], env={**env, "TENSORFOLD_PLE_DEFER": "0"},
+                         capture_output=True, text=True).stdout.strip()
+    return on == "True" and off == "False", f"default {on}, TENSORFOLD_PLE_DEFER=0 {off}"
+
+
+check("deferred: the n-gram layer stages the rows before its first kernel, the same bytes as stage would", deferred)
+check("no n-gram layer: nothing deferred", no_ple)
+check("the decode round defers alone, not beside a shared prompt pass, and clears it after its forward",
+      round_wiring)
+check("TENSORFOLD_PLE_DEFER=0 turns it off", switch)
+print("ALL PASS" if not fails else f"{fails} FAIL", flush=True)
+sys.exit(1 if fails else 0)
