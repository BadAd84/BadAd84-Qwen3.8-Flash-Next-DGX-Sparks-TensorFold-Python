diff --git a/tools/tokenize_check.py b/tools/tokenize_check.py
new file mode 100644
index 0000000..8a0d039
--- /dev/null
+++ b/tools/tokenize_check.py
@@ -0,0 +1,139 @@
+#!/usr/bin/env python3
+"""tools/tokenize_check.py <tokenizer.json> [text dir...]: patch 0018, CPU only, in the image (the server running or
+not). The server's own `App._encode_ids` (called on a stand-in holding the real Qwen3.8 Flash Next tokenizer) must give
+exactly `tok.encode(text, add_special_tokens=flag).ids` for both flags over: every .py file of the installed
+tensorfold package and every .md / .py / .sh file under the given dirs (the recipe checkout, say), all of them as one
+string, a long numbered filler, every added/special token's text interleaved with words, random Unicode (CJK, emoji,
+combining marks, controls) and edge cases; and, on a small template tokenizer whose special tokens the flag adds, that
+the flag passes through. Every `self.tok.encode(...)` call in the server must go through `_encode_ids`. And it must
+tokenize with Python's GIL released: a counting thread keeps at least half its idle rate during a ~870k-token encode
+(`encode` holds the GIL and leaves it near 1%). Prints PASS / FAIL lines and ALL PASS; exit 1 on any FAIL.
+
+    docker run --rm --entrypoint python3 -v "$PWD/tools/tokenize_check.py:/c.py:ro" -v "$PWD:/recipe:ro" \
+      -v "$HOME/.cache/huggingface:/hf:ro" tensorfold-qwen38:v0.6.1 /c.py \
+      /hf/hub/models--Vontra--Qwen3.8-Flash-Next-MLX-4bit-MTP/snapshots/<rev>/tokenizer.json /recipe
+"""
+import ast
+import inspect
+import pathlib
+import random
+import sys
+import threading
+import time
+
+import tensorfold
+from tokenizers import Tokenizer, models, pre_tokenizers, processors
+
+import tensorfold.cuda.server as server
+from tensorfold.cuda.server import App
+
+tok = Tokenizer.from_file(sys.argv[1])
+stand_in = type("S", (), {"tok": tok})()
+fails = 0
+
+
+def check(name, fn):
+    global fails
+    try:
+        ok, detail = fn()
+    except Exception as exc:                          # noqa: BLE001  (a missing or broken helper is a FAIL)
+        ok, detail = False, f"{type(exc).__name__}: {exc}"
+    print(("PASS " if ok else "FAIL ") + name + (f" ({detail})" if detail else ""), flush=True)
+    fails += not ok
+
+
+def same(text):
+    return all(App._encode_ids(stand_in, text, f) == tok.encode(text, add_special_tokens=f).ids for f in (False, True))
+
+
+def routed():
+    tree = ast.parse(inspect.getsource(server))
+    direct = [n.lineno for n in ast.walk(tree) if isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute)
+              and n.func.attr == "encode" and ast.unparse(n.func.value) == "self.tok"]
+    helper = [n.lineno for n in ast.walk(tree) if isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute)
+              and n.func.attr == "_encode_ids"]
+    return not direct and len(helper) >= 5, f"direct self.tok.encode calls at lines {direct}, {len(helper)} through the helper"
+
+
+files = sorted(pathlib.Path(tensorfold.__file__).parent.rglob("*.py"))
+for d in sys.argv[2:]:
+    files += sorted(p for p in pathlib.Path(d).rglob("*") if p.suffix in (".md", ".py", ".sh") and p.is_file())
+corpus = "".join(f.read_text(errors="replace") for f in files)
+words = ("lattice probe ferrule datum spindle gauge trellis offset stylus kinematic fixture wafer cosine baseline "
+         "granite bearing encoder servo axis spline tolerance flatness runout").split()
+rnd = random.Random(591)
+filler = "\n".join(f"{i:06d} " + " ".join(rnd.choice(words) for _ in range(11)) for i in range(20000))
+special = [t.content for t in tok.get_added_tokens_decoder().values()]
+
+
+def files_each():
+    bad = [str(f) for f in files if not same(f.read_text(errors="replace"))]
+    return not bad and len(files) > 50, f"{len(files)} files" + (f", differ: {bad[:3]}" if bad else "")
+
+
+def mixed():
+    texts = [" ".join(rnd.choice(special + words + ["\n", "  ", "\t"]) for _ in range(400)) for _ in range(50)]
+    return all(same(t) for t in texts) and len(special) > 0, f"{len(special)} added tokens"
+
+
+def unicode():
+    ranges = [(0x4E00, 0x9FFF), (0x1F300, 0x1FAFF), (0x0300, 0x036F), (0x0000, 0x001F), (0x0400, 0x04FF),
+              (0x0600, 0x06FF)]
+    uni = ["".join(chr(rnd.randint(*rnd.choice(ranges))) for _ in range(rnd.randint(1, 3000))) for _ in range(200)]
+    return all(same(t) for t in uni), ""
+
+
+def edge():
+    cases = ["", " ", "\n", "\n\n", "\t" * 50, " " * 1000, "a", "\u00a0\u2003", "<|im_start|>", "</think>\n",
+             "<tool_call>\n"]
+    return all(same(t) for t in cases), ""
+
+
+def flag():
+    # Qwen's tokenizer adds nothing for add_special_tokens, so a tokenizer whose template does add tokens makes the
+    # flag's pass-through observable
+    t2 = Tokenizer(models.WordLevel({"[UNK]": 0, "[BOS]": 1, "[EOS]": 2, "hello": 3, "world": 4}, unk_token="[UNK]"))
+    t2.pre_tokenizer = pre_tokenizers.Whitespace()
+    t2.post_processor = processors.TemplateProcessing(single="[BOS] $A [EOS]",
+                                                      special_tokens=[("[BOS]", 1), ("[EOS]", 2)])
+    s2 = type("S2", (), {"tok": t2})()
+    differs = t2.encode("hello world", add_special_tokens=True).ids != t2.encode("hello world", add_special_tokens=False).ids
+    return differs and all(App._encode_ids(s2, "hello world", f) == t2.encode("hello world", add_special_tokens=f).ids
+                           for f in (False, True)), ""
+
+
+def gil():
+    big = filler * 2                                  # ~870k tokens
+    count, stop = [0], [False]
+
+    def spin():
+        while not stop[0]:
+            count[0] += 1
+
+    th = threading.Thread(target=spin, daemon=True)
+    th.start()
+    time.sleep(0.3)
+    c0, t0 = count[0], time.perf_counter()
+    time.sleep(0.5)
+    idle = (count[0] - c0) / (time.perf_counter() - t0)
+    c0, t0 = count[0], time.perf_counter()
+    try:
+        n = len(App._encode_ids(stand_in, big, False))
+    finally:
+        s = time.perf_counter() - t0
+        stop[0] = True
+    rate = (count[0] - c0) / s / idle
+    return rate >= 0.5, f"{n} tokens in {1000 * s:.0f} ms, the other thread at {rate:.0%} of idle"
+
+
+check("every self.tok.encode call in the server goes through _encode_ids", routed)
+check("real code and prose files, each, both flags", files_each)
+check(f"all of them as one string ({len(corpus) / 1e6:.1f} MB), both flags", lambda: (same(corpus), ""))
+check("a numbered filler, both flags", lambda: (same(filler), ""))
+check("added/special tokens' texts interleaved with words (50 strings), both flags", mixed)
+check("200 random Unicode strings (CJK, emoji, combining marks, controls, Cyrillic, Arabic), both flags", unicode)
+check("edge cases (empty, whitespace runs, single tokens), both flags", edge)
+check("add_special_tokens passes through (a template tokenizer: the flag changes its ids)", flag)
+check("tokenizes with the GIL released", gil)
+print("ALL PASS" if not fails else f"{fails} FAIL", flush=True)
+sys.exit(1 if fails else 0)
