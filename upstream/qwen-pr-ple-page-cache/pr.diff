++def _cached(reads: list[tuple[int, int, int, memoryview, int]]) -> list[tuple[int, int, int, memoryview, int]]:
++    """Do each read here where the page cache holds it (RWF_NOWAIT); returns the reads, or their rests, still to do.
++
++    A cached read costs about a microsecond on this thread, against tens of microseconds of handing it to a worker
++    thread; the bytes are the file's either way."""
++
++    global _NOWAIT
++    left = []
++    for i, (fd, offset, size, out, at) in enumerate(reads):
++        try:
++            done = os.preadv(fd, [out[at:at + size]], offset, _NOWAIT)
++        except BlockingIOError:                  # not cached: a worker reads it
++            done = 0
++        except OSError:                          # the file system refuses RWF_NOWAIT: the threads read, as before
++            _NOWAIT = None
++            return left + reads[i:]
++        if done < size:
++            left.append((fd, offset + done, size - done, out, at + done))
