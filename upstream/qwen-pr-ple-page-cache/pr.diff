+ 
++    def will_need(self, ids: np.ndarray) -> None:
++        """Start reading rows ``ids`` into the page cache (POSIX_FADV_WILLNEED) and return: a later gather of them
++        finds them cached. A hint: it changes no bytes and ignores ids it can't place."""
++
++        if not self._closer.alive or not hasattr(os, "posix_fadvise"):
++            return
++        flat = np.unique(np.asarray(ids, dtype=np.int64).reshape(-1))
++        if not flat.size or flat[0] < 0 or flat[-1] >= self.rows:
++            return
++        shard = np.searchsorted(self.starts, flat, side="right") - 1
++        local, fds = flat - self.starts[shard], self._fd_of[self.fidx[shard]].tolist()
++        try:
++            for part, width in enumerate((self.wrow, self.grow, self.grow)):
++                for fd, offset in zip(fds, (self.bases[shard, part] + local * width).tolist()):
++                    os.posix_fadvise(fd, offset, width, os.POSIX_FADV_WILLNEED)
++        except OSError:                              # closed meanwhile: nothing to warm
++            pass
