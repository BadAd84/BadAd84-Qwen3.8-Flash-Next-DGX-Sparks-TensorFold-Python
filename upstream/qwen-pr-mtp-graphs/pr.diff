++
++class ChainGraphs:
++    """CUDA graphs of the MTP head's steps of one row a stream (every chain step after a round's absorb, and absorbs of
++    one kept row). Eager, such a step's ~40 launches cost more host time than its GPU work and the GPU waited for each
++    round trip; a replay launches it at once. Keyed by the stepping streams' MTP cache addresses (captured as the
++    attention's pointer table) and a power-of-two context bucket: the sparse select is launched for every stream with
++    the bucket as its context (its kernels read each row's real end from the device: extra blocks and chunks score,
++    select and merge nothing), so a replay computes exactly what the eager step does. Per replay only the rows'
++    positions are uploaded, one pinned copy. Drafts change speed only; these drafts are also the eager drafts' bits.
++    A key is captured the second time it is seen (one-off sets of chaining streams stay eager) and the least recently
++    replayed graph goes past ``GRAPH_LIMIT``."""
++
++    def __init__(self, md: "MultiDecoder") -> None:
++        self.md = md
++        self.graphs: OrderedDict = OrderedDict()    # key -> (graph, step, its ints, logits, pinned ints, copy event)
++        self.seen: dict = {}                         # key -> eager steps so far (captured at the second)
++        self.pool = torch.cuda.graph_pool_handle()
++        self.captures = 0
++
++    @staticmethod
++    def _key(segs: list, bucket: int) -> tuple:
++        return (bucket, tuple((id(st), st.mtp_kc.k.data_ptr(), st.mtp_kc.v.data_ptr(), st.mtp_kc.ks.data_ptr(),
++                               st.mtp_kc.vs.data_ptr(), st.mtp_ikc.data_ptr(), st.mtp_pooled.data_ptr(),
++                               st.mtp_pos.data_ptr()) for st, _, _ in segs))
++
++    def run(self, segs: list) -> torch.Tensor | None:
++        """The step's draft-head logits from a replay (captured on a key's second step), or None: run it eagerly."""
++
++        if any(a1 - a0 != 1 for _, a0, a1 in segs) or any(st.image_positions is not None for st, _, _ in segs):
++            return None
++        k = len(segs)
++        end = max(st.mtp_len + 1 for st, _, _ in segs)
++        bucket = max(GRAPH_BUCKET, 1 << (end - 1).bit_length())
++        key = self._key(segs, bucket)
++        hit = self.graphs.get(key)
++        if hit is not None:
++            g, _, ints, out, host, done = hit
++            self.graphs.move_to_end(key)
++            done.synchronize()                       # the previous replay's table copy has left the pinned buffer
++            vals = host.numpy()
++            for i, (st, _, _) in enumerate(segs):
++                vals[i] = vals[2 * k + i] = st.mtp_len   # posr and first: one row a stream, at its MTP length
++            ints.copy_(host, non_blocking=True)
++            done.record()
++            g.replay()
++            return out
++        if len(self.seen) > SEEN_LIMIT:
++            self.seen.clear()
++        self.seen[key] = self.seen.get(key, 0) + 1
++        if self.seen[key] < 2:
++            return None
++        while len(self.graphs) >= GRAPH_LIMIT:
++            self.graphs.popitem(last=False)
++        md = self.md
++        step = attn_multi.Step(md.w, segs, mtp=True)
++        host = torch.cat([step.posr, step.sid, step.first, step.counts]).cpu().pin_memory()
++        ints = host.to(md.w.device)
++        step.posr, step.sid, step.first, step.counts = ints[:k], ints[k:2 * k], ints[2 * k:3 * k], ints[3 * k:]
++        step.ends = [bucket] * k
++        md.mbuf.attn_step = step
++        try:
++            out = mtp_compute(md.w, segs, md.mbuf)        # this step's result, and every launch shape compiled
++            g = self._capture(lambda: mtp_compute(md.w, segs, md.mbuf))
++        finally:
++            md.mbuf.attn_step = None
++        done = torch.cuda.Event()
++        done.record()
++        self.graphs[key] = (g, step, ints, out, host, done)   # the step keeps its captured tables alive
++        return out
++
++    def _capture(self, fn) -> torch.cuda.CUDAGraph:
++        import gc
++
++        torch.cuda.synchronize()
++        g = torch.cuda.CUDAGraph()
++        enabled = gc.isenabled()                     # collecting an old graph mid-capture invalidates the capture
++        gc.disable()
++        try:
++            with torch.cuda.graph(g, pool=self.pool, capture_error_mode="thread_local"):
++                fn()
++        finally:
++            if enabled:
++                gc.enable()
++        torch.cuda.synchronize()
++        self.captures += 1
++        return g
++
