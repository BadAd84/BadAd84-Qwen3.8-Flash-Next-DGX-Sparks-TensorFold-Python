@@ -0,0 +1,231 @@
+#!/usr/bin/env python3
+"""tools/mtp_graph_check.py: patch 0016 (the MTP head's chain steps as CUDA graphs), CPU only, no model, in the image:
+
+    docker run --rm --entrypoint python3 -v "$PWD/tools:/t:ro" tensorfold-qwen38:v0.6.1 /t/mtp_graph_check.py
+
+`ChainGraphs.run`'s bookkeeping, on the CPU: CUDA graphs are stood in for by recorders whose replay re-runs the
+captured kernel on the tensors it captured (as a replay does), and `mtp_compute` by a kernel that writes each row's
+"logits" from the step's position tables on the device side, and marks a row whose real end lies past the step's
+context. The patch's own `attn_multi.Step` builds the tables. Checks: a step is eager the first time its key is seen and
+a replay afterwards; every replay computes what an eager step would for the streams' current positions (the positions
+and block starts uploaded, the context bucket a power of two >= 8192 covering every row, a new bucket a new key);
+steps of more than one row a stream and image streams stay eager; at most 32 graphs, the least recently replayed
+dropped; `MultiDecoder._mtp` replays through it, else runs the eager step and clears its tables; and
+`TENSORFOLD_MTP_GRAPHS=0` turns it off. That a replay's GPU kernels give the eager step's bits is measured on the GPU,
+not here. Prints PASS / FAIL lines and ALL PASS; exit 1 on any FAIL.
+"""
+from __future__ import annotations
+
+import contextlib
+import os
+import subprocess
+import sys
+from types import SimpleNamespace as NS
+
+import torch
+
+fails = 0
+
+
+def check(name, fn):
+    global fails
+    try:
+        ok, detail = fn()
+    except Exception as exc:                          # noqa: BLE001  (a missing or broken piece is a FAIL)
+        ok, detail = False, f"{type(exc).__name__}: {exc}"
+    print(("PASS " if ok else "FAIL ") + name + (f" ({detail})" if detail else ""), flush=True)
+    fails += not ok
+
+
+# --- CUDA stand-ins: a graph records the kernels launched while it captures and re-runs them at each replay
+CAPTURING: list = []
+
+
+class Graph:
+    def __init__(self):
+        self.kernels, self.replays = [], 0
+
+    def replay(self):
+        self.replays += 1
+        for k in self.kernels:
+            k()
+
+
+@contextlib.contextmanager
+def graph(g, pool=None, capture_error_mode=None):
+    CAPTURING.append(g)
+    try:
+        yield
+    finally:
+        CAPTURING.pop()
+
+
+class Event:
+    def record(self):
+        pass
+
+    def synchronize(self):
+        pass
+
+
+class Pinned(torch.Tensor):
+    """Pinned host memory: ``.to(device)`` is a separate copy, as on a GPU (a CPU tensor's ``.to("cpu")`` is itself)."""
+
+    def to(self, *a, **k):
+        return self.as_subclass(torch.Tensor).clone()
+
+
+torch.cuda.CUDAGraph, torch.cuda.graph, torch.cuda.Event = Graph, graph, Event
+torch.cuda.graph_pool_handle = lambda: "pool"
+torch.cuda.synchronize = lambda *a, **k: None
+torch.Tensor.pin_memory = lambda self, *a, **k: self.as_subclass(Pinned)
+
+from tensorfold.families.qwen4_exp.cuda import multi as m  # noqa: E402
+
+LAUNCHES = [0]
+
+
+def mtp_compute(w, segs, b, **kw):
+    """The step's 'kernel': logits[i] = position * 1000 + block start, + 10^6 where the row's end passes the step's
+    context; the step's tables are the ones on b.attn_step when it launches (captured with it)."""
+    step, k = b.attn_step, len(segs)
+    out = b.logits[:k]
+
+    def kernel():
+        LAUNCHES[0] += 1
+        ends = torch.tensor(step.ends[:k], dtype=torch.int64)
+        out.copy_(step.posr[:k].long() * 1000 + step.first[:k].long() + 10**6 * (step.posr[:k].long() + 1 > ends))
+
+    if CAPTURING:
+        CAPTURING[-1].kernels.append(kernel)
+    else:
+        kernel()
+    return out
+
+
+m.mtp_compute = mtp_compute
+
+
+class St:
+    def __init__(self, n):
+        self.mtp_kc = NS(k=torch.zeros(1), v=torch.zeros(1), ks=torch.zeros(1), vs=torch.zeros(1))
+        self.mtp_ikc, self.mtp_pooled, self.mtp_pos = torch.zeros(1), torch.zeros(1), torch.zeros(1)
+        self.mtp_len, self.image_positions, self.pos = n, None, n
+        self.pos_dev, self.rope_delta_dev = torch.zeros(1), torch.zeros(1)
+
+
+def md():
+    d = object.__new__(m.MultiDecoder)
+    d.w = NS(device=torch.device("cpu"), layers=[], mtp=NS(layer=NS(index=0, linear=False)))
+    d.mbuf = NS(logits=torch.zeros(64, dtype=torch.int64), attn_step=None)
+    return d
+
+
+def segs_of(sts, rows=1):
+    return [(st, i * rows, i * rows + rows) for i, st in enumerate(sts)]
+
+
+def want(sts):
+    return [st.mtp_len * 1001 for st in sts]
+
+
+def chain():
+    """Three streams step from MTP length 100 to 3000 (one key: the 8192 bucket), then two of them on past 8192."""
+    d = md()
+    cg = m.ChainGraphs(d)
+    sts = [St(100), St(1500), St(40)]
+    first = cg.run(segs_of(sts)) is None
+    bad, eager = [], 0
+    for step in range(2900):
+        for st in sts:
+            st.mtp_len += 1
+        out = cg.run(segs_of(sts))
+        if out is None:
+            eager += 1
+        elif out.tolist() != want(sts):
+            bad.append((step, out.tolist(), want(sts)))
+    replays = sum(g.replays for g, *_ in cg.graphs.values())
+    two = sts[1:]
+    for st in two:
+        st.mtp_len = 8100
+    crossed = 0
+    for step in range(200):                           # 8101 .. 8300: the 8192 bucket, then the 16384 one
+        for st in two:
+            st.mtp_len += 1
+        before = sum(g.replays for g, *_ in cg.graphs.values())
+        out = cg.run(segs_of(two))
+        if out is not None and out.tolist() != want(two):
+            bad.append(("past 8192", out.tolist()[:2], want(two)))
+        if sum(g.replays for g, *_ in cg.graphs.values()) > before and max(st.mtp_len for st in two) + 1 > 8192:
+            crossed += 1
+    keys = sorted(k[0] for k in cg.graphs)
+    ok = first and eager == 0 and replays == 2899 and not bad and crossed > 50 and keys == [8192, 8192, 16384]
+    return ok, f"first sight eager {first}; then {replays} replays, {eager} more eager steps; {crossed} replays " \
+        f"past 8192; graphs' buckets {keys}; wrong {bad[:2]}"
+
+
+def eager_only():
+    d = md()
+    cg = m.ChainGraphs(d)
+    sts = [St(10), St(20)]
+    multi = [cg.run(segs_of(sts, rows=2)) for _ in range(3)]
+    img, other = St(30), St(5)
+    img.image_positions = torch.zeros(3)
+    image = [cg.run(segs_of([img, other])) for _ in range(3)]
+    return all(x is None for x in multi + image) and not cg.graphs, \
+        f"two rows a stream {multi}, an image stream {image}"
+
+
+def limit():
+    d = md()
+    cg = m.ChainGraphs(d)
+    sets = [[St(100 + i)] for i in range(m.GRAPH_LIMIT + 1)]
+    for s in sets[:m.GRAPH_LIMIT]:                    # 32 graphs: each key seen twice
+        cg.run(segs_of(s))
+        cg.run(segs_of(s))
+    cg.run(segs_of(sets[0]))                          # the first is replayed again: the second is now the oldest
+    cg.run(segs_of(sets[-1]))
+    cg.run(segs_of(sets[-1]))                         # a 33rd graph
+    held = {k[1][0][0] for k in cg.graphs}
+    ok = m.GRAPH_LIMIT == 32 and len(cg.graphs) == 32 and id(sets[1][0]) not in held and id(sets[0][0]) in held \
+        and id(sets[-1][0]) in held
+    return ok, f"{len(cg.graphs)} graphs, the least recently replayed dropped {id(sets[1][0]) not in held}, " \
+        f"the replayed one kept {id(sets[0][0]) in held}"
+
+
+def through_mtp():
+    d = md()
+    d.chain_graphs = m.ChainGraphs(d)
+    sts = [St(500), St(900)]
+    outs = []
+    for _ in range(4):
+        for st in sts:
+            st.mtp_len += 1
+        outs.append(m.MultiDecoder._mtp(d, segs_of(sts)).tolist() == want(sts))
+    replayed = sum(g.replays for g, *_ in d.chain_graphs.graphs.values())
+    cleared = d.mbuf.attn_step is None
+    d.chain_graphs = None
+    eager = m.MultiDecoder._mtp(d, segs_of(sts, rows=1)).tolist() == want(sts) and d.mbuf.attn_step is None
+    return all(outs) and replayed == 2 and cleared and eager, \
+        f"steps right {outs}, replays {replayed}, tables cleared {cleared}, eager without graphs {eager}"
+
+
+def switch():
+    code = "from tensorfold.families.qwen4_exp.cuda import multi as m; print(m.MTP_GRAPHS)"
+    env = {k: v for k, v in os.environ.items() if k != "TENSORFOLD_MTP_GRAPHS"}
+    on = subprocess.run([sys.executable, "-c", code], env=env, capture_output=True, text=True).stdout.strip()
+    off = subprocess.run([sys.executable, "-c", code], env={**env, "TENSORFOLD_MTP_GRAPHS": "0"},
+                         capture_output=True, text=True).stdout.strip()
+    built = "ChainGraphs(self) if MTP_GRAPHS and self.mbuf is not None else None" in \
+        __import__("inspect").getsource(m.MultiDecoder.__init__)
+    return on == "True" and off == "False" and built, f"default {on}, TENSORFOLD_MTP_GRAPHS=0 {off}, wired {built}"
+
+
+check("one key from MTP length 100 to 3000: eager at first sight, then replays computing the current positions; "
+      "a new bucket past 8192", chain)
+check("steps of two rows a stream, and image streams, stay eager", eager_only)
+check("at most 32 graphs; the least recently replayed goes first", limit)
+check("MultiDecoder._mtp replays through ChainGraphs, else steps eagerly; the step's tables are cleared", through_mtp)
+check("TENSORFOLD_MTP_GRAPHS=0 turns the graphs off", switch)
+print("ALL PASS" if not fails else f"{fails} FAIL", flush=True)
+sys.exit(1 if fails else 0)
