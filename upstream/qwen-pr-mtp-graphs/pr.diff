+        (0.9268, 0.7479), (0.9932, 0.9507))
++# The MTP head's one-row-a-stream steps as CUDA graphs (``ChainGraphs``); TENSORFOLD_MTP_GRAPHS=0 runs them eagerly.
++MTP_GRAPHS = os.environ.get("TENSORFOLD_MTP_GRAPHS", "1") != "0"
++GRAPH_BUCKET = 8192              # the smallest context bucket a chain-step graph's sparse select covers
++GRAPH_LIMIT = 32                 # chain-step graphs kept (the least recently replayed dropped past it)
++SEEN_LIMIT = 4096                # keys counted before the count starts over
+ 
+ 
+ def _hinted(w) -> bool:
+@@ -83,6 +89,94 @@
